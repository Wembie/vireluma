# Copy to apps/web/.env for local overrides. Only PUBLIC_* values belong in the
# frontend: they are embedded in the static build and visible to everyone.
# NEVER put a Supabase service-role key, database password or any secret here.

# Deployment origin and base path (see docs/deployment/custom-domain-migration.md)
PUBLIC_SITE_ORIGIN=https://wembie.github.io
PUBLIC_BASE_PATH=/vireluma

# local | development | production — only production builds are indexable
PUBLIC_APP_ENV=local

# Source repository shown in the footer
PUBLIC_REPOSITORY_URL=https://github.com/Wembie/vireluma

# Milestone 2 (not used yet): Supabase project URL and *publishable* key.
# The publishable key is public by design; data is protected by Row Level Security.
# PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
