---
/**
 * Illustrative preview of the public emergency page, clearly labelled as an
 * example. It uses the same tokens and patterns the real page will use; its
 * buttons are presentational (no phone numbers, no fake actions).
 */
import { Ear, MessageCircleHeart, Phone, Siren } from '@lucide/astro';
import type { Locale } from '@vireluma/domain';
import { getDictionary } from '../../i18n';
import Logo from '../brand/Logo.astro';

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className } = Astro.props;
const t = getDictionary(locale).sample;
---

<figure class:list={['vl-phone', className]} aria-label={`${t.badge}: ${t.scanned}`}>
  <div class="vl-phone__screen">
    <div class="flex items-center justify-between border-b border-[#e2e8f0] px-4 py-3">
      <div class="h-5">
        <Logo label={null} variant="symbol" tone="on-light" class="h-5" />
      </div>
      <span class="rounded-full bg-[#fdf1dc] px-2.5 py-0.5 text-[0.6875rem] font-semibold text-[#7a4a06]">
        {t.badge}
      </span>
    </div>
    <div class="px-4 pt-4 pb-5">
      <p class="text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-[#0f766e]">{t.scanned}</p>
      <div class="mt-2 flex items-center gap-3">
        <div
          class="flex size-12 items-center justify-center rounded-full bg-[#d5f3ee] font-display text-xl font-bold text-[#102a43]"
          aria-hidden="true"
        >
          E
        </div>
        <p class="font-display text-2xl font-bold text-[#102a43]">{t.name}</p>
      </div>
      <p class="mt-3 rounded-lg bg-[#ecfaf7] p-3 text-[0.8125rem] leading-snug text-[#172b3a]">
        <MessageCircleHeart class="mb-1 size-4 text-[#0f766e]" aria-hidden="true" />
        {t.message}
      </p>
      <p class="mt-4 text-xs font-semibold text-[#102a43]">{t.needsTitle}</p>
      <ul class="mt-1.5 grid gap-1.5 text-[0.8125rem] text-[#172b3a]">
        {t.needs.map((n, i) => (
          <li class="flex items-start gap-2">
            {i === 1 ? (
              <Ear class="mt-0.5 size-3.5 shrink-0 text-[#0f766e]" aria-hidden="true" />
            ) : (
              <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-[#0f766e]" aria-hidden="true" />
            )}
            {n}
          </li>
        ))}
      </ul>
      <p class="mt-4 text-xs font-semibold text-[#102a43]">{t.contactsTitle}</p>
      <div class="mt-1.5 flex items-center justify-between rounded-lg border border-[#e2e8f0] p-2.5">
        <div>
          <p class="text-sm font-semibold text-[#172b3a]">{t.contactName}</p>
          <p class="text-xs text-[#64748b]">{t.contactRelation}</p>
        </div>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-[#0f766e] px-3.5 py-2 text-xs font-semibold text-white">
          <Phone class="size-3.5" aria-hidden="true" />
          {t.call}
        </span>
      </div>
      <span class="mt-2.5 flex w-full items-center justify-center gap-2 rounded-full bg-[#b91c1c] px-3 py-2.5 text-xs font-semibold text-white">
        <Siren class="size-3.5" aria-hidden="true" />
        {t.emergency}
      </span>
    </div>
  </div>
</figure>

<style>
  /* The phone mock always shows the light emergency UI, regardless of site theme. */
  .vl-phone {
    width: 100%;
    max-width: 18.5rem;
    padding: 0.55rem;
    border-radius: 2.4rem;
    background: linear-gradient(160deg, #1b3a57, #0b1d2e);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.06) inset,
      0 40px 70px -30px rgb(16 42 67 / 0.55),
      0 18px 30px -18px rgb(16 42 67 / 0.4);
  }
  .vl-phone__screen {
    overflow: hidden;
    border-radius: 1.9rem;
    background: #ffffff;
    color: #172b3a;
    user-select: none;
  }
</style>
