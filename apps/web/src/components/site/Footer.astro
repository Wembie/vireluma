---
import type { Locale } from '@vireluma/domain';
import { build, project, securityPolicyUrl, urls } from '../../config/site';
import { HTML_LANG, LOCALES, getDictionary, routePath, type RouteKey } from '../../i18n';
import Logo from '../brand/Logo.astro';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
}

const { locale, routeKey } = Astro.props;
const t = getDictionary(locale);
const product = (['howItWorks', 'useCases', 'qrNfc', 'security', 'faq'] as const).map((key) => ({
  label: t.nav[key],
  href: urls.path(routePath(locale, key)),
}));
const year = new Date().getFullYear();
---

<footer class="mt-auto bg-surface-brand text-fg-on-brand">
  <div class="container-page grid gap-12 py-16 md:grid-cols-[1.4fr_1fr_1fr] md:py-20">
    <div class="max-w-sm">
      <a href={urls.path(routePath(locale, 'home'))} class="inline-block h-10" aria-label={t.a11y.homeLink}>
        <Logo label={null} tone="on-dark" class="h-10" />
      </a>
      <p class="mt-5 font-display text-lg font-semibold text-fg-on-brand">{t.meta.tagline}</p>
      <p class="mt-3 text-sm text-fg-on-brand-muted">{t.footer.description}</p>
    </div>

    <nav aria-label={t.a11y.footerNav}>
      <h2 class="font-sans text-caption font-semibold uppercase tracking-wider !text-brand-mint">
        {t.footer.product}
      </h2>
      <ul class="mt-4 grid gap-1">
        {product.map((l) => (
          <li>
            <a
              href={l.href}
              class="inline-flex min-h-10 items-center text-fg-on-brand no-underline hover:underline"
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div>
      <h2 class="font-sans text-caption font-semibold uppercase tracking-wider !text-brand-mint">
        {t.footer.project}
      </h2>
      <ul class="mt-4 grid gap-1">
        <li>
          <a
            href={project.repositoryUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-10 items-center text-fg-on-brand no-underline hover:underline"
          >
            {t.footer.sourceCode}
            <span class="sr-only">{t.a11y.opensInNewTab}</span>
          </a>
        </li>
        <li>
          <a
            href={securityPolicyUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-10 items-center text-fg-on-brand no-underline hover:underline"
          >
            {t.footer.security}
            <span class="sr-only">{t.a11y.opensInNewTab}</span>
          </a>
        </li>
      </ul>
      <h2 class="mt-8 font-sans text-caption font-semibold uppercase tracking-wider !text-brand-mint">
        {t.nav.language}
      </h2>
      <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1">
        {LOCALES.map((l) => (
          <li>
            <a
              href={urls.path(routePath(l, routeKey))}
              hreflang={HTML_LANG[l]}
              lang={HTML_LANG[l]}
              aria-current={l === locale ? 'true' : undefined}
              class="inline-flex min-h-10 items-center text-fg-on-brand-muted no-underline hover:text-fg-on-brand aria-[current=true]:font-semibold aria-[current=true]:text-fg-on-brand"
            >
              {getDictionary(l).meta.languageName}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page grid gap-4 py-8 text-sm text-fg-on-brand-muted">
      <p class="max-w-3xl">{t.footer.disclaimer}</p>
      <p>{t.footer.legalPending}</p>
      <p class="flex flex-wrap gap-x-4 gap-y-1">
        <span>© {year} VIRELUMA</span>
        <span>
          {t.footer.version} <span class="font-mono">{build.version}</span>
          <span class="font-mono opacity-80">({build.sha.slice(0, 7)})</span>
        </span>
      </p>
    </div>
  </div>
</footer>
