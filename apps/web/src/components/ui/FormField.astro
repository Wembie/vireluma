---
/**
 * Label + control + hint + error wiring. The control is passed in the default
 * slot and must use the `id`, `describedBy` and `invalid` values given here
 * (see Input/Textarea/Select which accept them directly).
 */
interface Props {
  id: string;
  label: string;
  hint?: string;
  error?: string;
  required?: boolean;
  requiredLabel?: string;
  class?: string;
}

const { id, label, hint, error, required = false, requiredLabel = '*', class: className } = Astro.props;
---

<div class:list={['grid gap-1.5', className]}>
  <label for={id} class="text-sm font-semibold text-fg">
    {label}
    {required && (
      <span class="ml-0.5 text-danger" aria-hidden="true">
        {requiredLabel}
      </span>
    )}
  </label>
  {hint && (
    <p id={`${id}-hint`} class="text-sm text-fg-muted">
      {hint}
    </p>
  )}
  <slot />
  {error && (
    <p id={`${id}-error`} class="flex items-start gap-1.5 text-sm font-medium text-danger">
      <span aria-hidden="true">●</span>
      {error}
    </p>
  )}
</div>
