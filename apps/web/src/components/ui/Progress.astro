---
/** Determinate progress (native <progress> semantics via role). Omit `value` for indeterminate. */
interface Props {
  label: string;
  value?: number;
  max?: number;
  showValue?: boolean;
  class?: string;
}

const { label, value, max = 100, showValue = true, class: className } = Astro.props;
const pct = value === undefined ? undefined : Math.round((Math.min(Math.max(value, 0), max) / max) * 100);
---

<div class:list={['grid gap-2', className]}>
  <div class="flex items-center justify-between text-sm">
    <span class="font-medium text-fg">{label}</span>
    {showValue && pct !== undefined && <span class="text-fg-muted tabular-nums">{pct}%</span>}
  </div>
  <div
    role="progressbar"
    aria-label={label}
    aria-valuemin={pct === undefined ? undefined : 0}
    aria-valuemax={pct === undefined ? undefined : 100}
    aria-valuenow={pct}
    class="h-2.5 overflow-hidden rounded-pill bg-bg-subtle"
  >
    <div
      class:list={['h-full rounded-pill bg-primary', pct === undefined && 'vl-indeterminate w-1/3']}
      style={pct === undefined ? undefined : `width:${pct}%`}
    ></div>
  </div>
</div>

<style>
  .vl-indeterminate {
    animation: vl-slide 1.4s var(--vl-ease-out) infinite;
  }
  @keyframes vl-slide {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(300%);
    }
  }
</style>
