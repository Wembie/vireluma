---
/** Native radio group in a fieldset: arrow-key navigation and grouping semantics come for free. */
interface Props {
  name: string;
  legend: string;
  options: { value: string; label: string; description?: string; disabled?: boolean }[];
  value?: string;
  layout?: 'stack' | 'cards';
  class?: string;
}

const { name, legend, options, value, layout = 'stack', class: className } = Astro.props;
---

<fieldset class:list={['grid gap-3', className]}>
  <legend class="mb-1 text-sm font-semibold text-fg">{legend}</legend>
  {options.map((o) => {
    const id = `${name}-${o.value}`;
    return (
      <label
        for={id}
        class:list={[
          'flex cursor-pointer items-start gap-3',
          layout === 'cards' &&
            'rounded-md border border-border bg-surface p-4 has-[:checked]:border-primary has-[:checked]:bg-primary-soft has-[:disabled]:cursor-not-allowed has-[:disabled]:opacity-60',
        ]}
      >
        <input
          id={id}
          type="radio"
          name={name}
          value={o.value}
          checked={o.value === value}
          disabled={o.disabled}
          class="mt-0.5 size-6 shrink-0 accent-[var(--vl-primary)]"
        />
        <span>
          <span class="block font-medium text-fg">{o.label}</span>
          {o.description && <span class="block text-sm text-fg">{o.description}</span>}
        </span>
      </label>
    );
  })}
</fieldset>
