---
/**
 * On/off switch built on a native checkbox with role="switch" (announced as
 * "switch, on/off"). Works without JavaScript inside forms.
 */
import type { HTMLAttributes } from 'astro/types';

type Props = {
  id: string;
  label: string;
  description?: string;
  class?: string;
} & Omit<HTMLAttributes<'input'>, 'class' | 'type' | 'role'>;

const { id, label, description, class: className, ...rest } = Astro.props;
---

<div class:list={['flex items-start justify-between gap-4', className]}>
  <div>
    <label for={id} class="cursor-pointer font-medium text-fg">
      {label}
    </label>
    {description && (
      <p id={`${id}-desc`} class="text-sm text-fg-muted">
        {description}
      </p>
    )}
  </div>
  <span class="vl-switch relative inline-flex shrink-0">
    <input
      id={id}
      type="checkbox"
      role="switch"
      class="peer absolute inset-0 z-10 size-full cursor-pointer opacity-0 disabled:cursor-not-allowed"
      aria-describedby={description ? `${id}-desc` : undefined}
      {...rest}
    />
    <span
      class="h-8 w-14 rounded-pill border border-border-strong bg-bg-subtle transition-colors duration-200 peer-checked:border-primary peer-checked:bg-primary peer-focus-visible:outline-3 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-focus peer-disabled:opacity-50"
      aria-hidden="true"
    ></span>
    <span
      class="absolute top-1 left-1 size-6 rounded-full bg-surface shadow-sm transition-transform duration-200 peer-checked:translate-x-6 dark:bg-fg"
      aria-hidden="true"
    ></span>
  </span>
</div>
