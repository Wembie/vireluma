---
/** Layout for localized public pages: SEO + hreflang alternates + header/footer. */
import type { Locale } from '@vireluma/domain';
import Footer from '../components/site/Footer.astro';
import Header from '../components/site/Header.astro';
import { alternates, routePath, type RouteKey } from '../i18n';
import BaseLayout from './BaseLayout.astro';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
}

const { locale, routeKey, title, description, jsonLd = [] } = Astro.props;
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  path={routePath(locale, routeKey)}
  alternates={alternates(routeKey)}
  xDefaultPath={routeKey === 'home' ? '' : routePath('en', routeKey)}
  jsonLd={jsonLd}
>
  <Header locale={locale} routeKey={routeKey} />
  <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
    <slot />
  </main>
  <Footer locale={locale} routeKey={routeKey} />
</BaseLayout>
