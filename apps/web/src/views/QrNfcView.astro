---
import { CreditCard, FlaskConical, Nfc, QrCode } from '@lucide/astro';
import type { Locale } from '@vireluma/domain';
import Wristband from '../components/marketing/Wristband.astro';
import PageHero from '../components/site/PageHero.astro';
import Alert from '../components/ui/Alert.astro';
import Card from '../components/ui/Card.astro';
import { getDictionary } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const p = t.pages.qrNfc;
const formats = [
  { ...p.qr, Icon: QrCode },
  { ...p.nfc, Icon: Nfc },
  { ...p.printed, Icon: CreditCard },
];
---

<PageHero locale={locale} routeKey="qrNfc" eyebrow={p.eyebrow} title={p.h1} intro={p.intro} />

<section class="section" aria-label={p.eyebrow}>
  <div class="container-page grid items-start gap-12 lg:grid-cols-[1.25fr_0.75fr]">
    <ul class="grid gap-5">
      {formats.map(({ title, body, Icon }) => (
        <li>
          <Card as="article" padding="lg" class="grid gap-5 sm:grid-cols-[auto_1fr]">
            <span class="flex size-12 items-center justify-center rounded-md bg-surface-brand text-brand-mint">
              <Icon class="size-6" aria-hidden="true" />
            </span>
            <div>
              <h2 class="text-h3">{title}</h2>
              <p class="mt-3 text-fg-muted">{body}</p>
            </div>
          </Card>
        </li>
      ))}
    </ul>
    <div class="flex flex-col items-center gap-4 rounded-xl bg-surface-accent px-6 py-14 lg:sticky lg:top-28">
      <Wristband locale={locale} />
      <p class="max-w-xs text-center text-sm text-fg">{t.sample.scanHint}</p>
    </div>
  </div>
</section>

<section class="section bg-surface" aria-labelledby="airtag-title">
  <div class="container-page grid gap-6 lg:grid-cols-2">
    <Card variant="subtle" padding="lg">
      <h2 id="airtag-title" class="text-h3">
        {p.airtag.title}
      </h2>
      <p class="mt-4 text-fg">{p.airtag.body}</p>
    </Card>
    <div class="grid content-start gap-4">
      <Alert tone="info" title={p.testing.title}>
        <p class="flex gap-2">
          <FlaskConical class="mt-1 size-4 shrink-0 text-info" aria-hidden="true" />
          <span>{p.testing.body}</span>
        </p>
      </Alert>
    </div>
  </div>
</section>
